# OpenAI API Key (Required for LLM debaters and observer)
OPENAI_API_KEY=your_openai_api_key_here

# Default Model (e.g., gpt-6-luna, gpt-5.6-luna, gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-6-luna

# Optional API Endpoint / Base URL (Leave empty for standard OpenAI, or set for custom proxy/OpenRouter)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Tavily API Key (Optional: for curated deep search; falls back to DuckDuckGo if omitted)
TAVILY_API_KEY=your_tavily_api_key_here

# Preferred Search Engine: 'hybrid' (Tavily for dossier, DDG for broad), 'tavily', or 'duckduckgo'
SEARCH_PROVIDER=hybrid
